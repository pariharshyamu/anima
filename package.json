{
  "name": "anima3d",
  "version": "0.55.0",
  "description": "ANIMA — professional humanoid characters and animation for three.js: seeded rigged bodies, procedural locomotion clips, and a blending locomotion controller. Pairs structurally with GAMA (agents) and SCENA (worlds).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "dev": "vite examples/parade",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "skate": "node bench/skate.mjs",
    "climb": "node bench/climb.mjs",
    "parkour": "node bench/parkour.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run skate && npm run mood && npm run lifting && npm run dining && npm run archery && npm run striking && npm run guard && npm run grappling && npm run fightstyle && npm run sparring && npm run tameshiwari && npm run blade",
    "dev:portrait": "vite examples/portrait",
    "dev:hoops": "vite examples/basketball",
    "dev:village": "vite examples/village",
    "site:dev": "node site/build-vendor.mjs && vite site",
    "site:build": "node site/sync-docs.mjs && node site/build-vendor.mjs && vite build site",
    "site:publish": "npm run site:build && node site/publish-docs.mjs",
    "dev:screens": "vite examples/screens",
    "dev:phone": "vite examples/phone",
    "dev:attention": "vite examples/attention",
    "dev:queue": "vite examples/queue",
    "dev:office": "vite examples/office",
    "dev:pool": "vite examples/pool",
    "dev:prep": "vite examples/prep",
    "dev:deck": "vite examples/deck",
    "dev:rowing": "vite examples/rowing",
    "verify:playgrounds": "npm run site:build && node site/verify-playgrounds.mjs",
    "mood": "node bench/mood.mjs",
    "lifting": "node bench/lifting.mjs",
    "dining": "node bench/dining.mjs",
    "archery": "node bench/archery.mjs",
    "striking": "node bench/striking.mjs",
    "guard": "node bench/guard.mjs",
    "grappling": "node bench/grappling.mjs",
    "fightstyle": "node bench/fightstyle.mjs",
    "sparring": "node bench/sparring.mjs",
    "tameshiwari": "node bench/tameshiwari.mjs",
    "blade": "node bench/blade.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pariharshyamu/anima.git"
  },
  "homepage": "https://github.com/pariharshyamu/anima#readme",
  "bugs": {
    "url": "https://github.com/pariharshyamu/anima/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "threejs",
    "character",
    "humanoid",
    "animation",
    "skeletal-animation",
    "procedural",
    "locomotion",
    "game-development",
    "3d"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^1.6.1",
    "gama3d": "^0.45.0",
    "playwright": "^1.56.1",
    "scena3d": "^0.108.0",
    "three": "^0.185.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
